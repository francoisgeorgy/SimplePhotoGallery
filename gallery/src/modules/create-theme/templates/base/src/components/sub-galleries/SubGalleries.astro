---
import Container from '@/components/container/Container.astro';

import type { ResolvedGalleryTranslation, ResolvedSubGallery } from '@simple-photo-gallery/common/theme';

interface Props {
  title?: string;
  parsedDescription?: string;
  subGalleries: ResolvedSubGallery[];
  isHomepage?: boolean;
  defaultLanguage?: string;
  translations?: Record<string, ResolvedGalleryTranslation>;
}

const { title, parsedDescription, subGalleries, isHomepage = false, defaultLanguage = 'en', translations } = Astro.props;
---

<section class="sub-galleries">
  <Container>
    {
      title && (
        <div class="sub-galleries__header">
          {translations &&
            Object.entries(translations).map(([language, translation]) => (
              <div data-language={language}>
                {isHomepage ? (
                  <h1 class="sub-galleries__header-title">{translation.title}</h1>
                ) : (
                  <h2 class="sub-galleries__header-title">{translation.title}</h2>
                )}
                {translation.parsedDescription && (
                  <div class="sub-galleries__header-description markdown-content" set:html={translation.parsedDescription} />
                )}
              </div>
            ))}
          {!translations && isHomepage && <h1 class="sub-galleries__header-title">{title}</h1>}
          {!translations && !isHomepage && <h2 class="sub-galleries__header-title">{title}</h2>}
          {!translations && parsedDescription && (
            <div class="sub-galleries__header-description markdown-content" set:html={parsedDescription} />
          )}
        </div>
      )
    }
    <div class="sub-galleries__grid">
      {
        subGalleries.map((subgallery) => (
          <a href={subgallery.resolvedPath || subgallery.path} class="sub-galleries__item">
            <div class="sub-galleries__item-image">
              <img src={subgallery.thumbnailPath} alt={subgallery.title} loading="lazy" />
            </div>
            <div class="sub-galleries__item-content">
              {subgallery.translations ? (
                Object.entries({
                  [defaultLanguage]: {
                    title: subgallery.title,
                    description: '',
                  },
                  ...subgallery.translations,
                }).map(([language, translation]) => (
                  <h3 class="sub-galleries__item-title" data-language={language}>
                    {translation.title}
                  </h3>
                ))
              ) : (
                <h3 class="sub-galleries__item-title">{subgallery.title}</h3>
              )}
            </div>
          </a>
        ))
      }
    </div>
  </Container>
</section>

<style>
  .sub-galleries {
    padding: 5rem 1rem;
    background-color: var(--color-surface-alt);
  }

  .sub-galleries__header {
    text-align: center;
    margin-bottom: 4rem;
  }

  .sub-galleries__header-title {
    font-size: clamp(2.5rem, 5vw, 5rem);
    font-weight: 700;
    margin-bottom: 1.5rem;
    color: var(--color-text);
    white-space: pre-line;
  }

  .sub-galleries__header-description {
    font-size: 1.125rem;
    color: var(--color-text-muted);
    max-width: 42rem;
    margin: 0 auto;
    line-height: 1.6;
  }

  .sub-galleries__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  .sub-galleries__item {
    display: block;
    text-decoration: none;
    color: inherit;
    border-radius: 0.75rem;
    overflow: hidden;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
    transition: all 0.3s ease;
    background-color: #333333;
  }

  .sub-galleries__item:hover {
    transform: scale(1.002) translateY(-5px);
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1);
  }

  .sub-galleries__item-image {
    position: relative;
    overflow: hidden;
    aspect-ratio: 16/9;
  }

  .sub-galleries__item-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .sub-galleries__item:hover .sub-galleries__item-image img {
    transform: scale(1.005);
  }

  .sub-galleries__item-content {
    padding: 1.5rem;
  }

  .sub-galleries__item-title {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-text);
    margin: 0;
    line-height: 1.4;
  }

  @media (max-width: 640px) {
    .sub-galleries__grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .sub-galleries__item-content {
      padding: 1rem;
    }
  }
</style>
