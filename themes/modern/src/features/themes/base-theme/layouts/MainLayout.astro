---
import MainHead from '@/features/themes/base-theme/layouts/MainHead.astro';

import type { GalleryMetadata } from '@simple-photo-gallery/common';
import type { ResolvedHero, ThumbnailConfig } from '@simple-photo-gallery/common/theme';

interface Props {
  title: string;
  description?: string;
  url?: string;
  metadata?: GalleryMetadata;
  analyticsScript?: string;
  heroSrcsets: ResolvedHero['srcsets'];
  preloadHero?: boolean;
  thumbnails?: Required<ThumbnailConfig>;
  defaultLanguage?: string;
  availableLanguages?: string[];
}

const {
  title,
  description,
  metadata,
  url,
  analyticsScript,
  heroSrcsets,
  preloadHero = true,
  thumbnails,
  defaultLanguage = metadata?.language || 'en',
  availableLanguages = [],
} = Astro.props;

const rowHeightMax = thumbnails?.size ?? 160;
---

<!doctype html>
<html lang={defaultLanguage} data-available-languages={availableLanguages.join(',')} data-default-language={defaultLanguage}>
  <MainHead
    title={title}
    description={description}
    metadata={metadata}
    url={url}
    heroSrcsets={heroSrcsets}
    preloadHero={preloadHero}
  />
  <script is:inline>
    (() => {
      const root = document.documentElement;
      const availableLanguages = (root.dataset.availableLanguages || '').split(',').filter(Boolean);
      if (availableLanguages.length < 2) return;

      const defaultLanguage = root.dataset.defaultLanguage || 'en';
      let savedLanguage;
      try {
        savedLanguage = localStorage.getItem('spg-language');
      } catch {
        // Storage can be unavailable in privacy-restricted browser contexts.
      }

      const preferredLanguages = navigator.languages || [navigator.language];
      const browserLanguage = preferredLanguages
        .map((preferred) =>
          availableLanguages.find(
            (language) =>
              preferred.toLowerCase() === language.toLowerCase() ||
              preferred.toLowerCase().startsWith(language.toLowerCase() + '-'),
          ),
        )
        .find(Boolean);
      const language = availableLanguages.includes(savedLanguage) ? savedLanguage : browserLanguage || defaultLanguage;
      root.lang = language;
    })();
  </script>
  <body style={`--row-height-max: ${rowHeightMax}px`}>
    <slot />

    {analyticsScript && <Fragment set:html={analyticsScript} />}
    <script is:inline>
      (() => {
        const availableLanguages = (document.documentElement.dataset.availableLanguages || '').split(',').filter(Boolean);
        if (availableLanguages.length < 2) return;

        const setLanguage = (language, persist) => {
          document.documentElement.lang = language;
          for (const button of document.querySelectorAll('[data-language-select]')) {
            button.setAttribute('aria-pressed', String(button.dataset.languageSelect === language));
          }

          if (persist) {
            try {
              localStorage.setItem('spg-language', language);
            } catch {
              // The selected language still applies to the current page.
            }
          }
        };

        for (const button of document.querySelectorAll('[data-language-select]')) {
          button.addEventListener('click', () => setLanguage(button.dataset.languageSelect, true));
        }
        setLanguage(document.documentElement.lang, false);
      })();
    </script>
  </body>
</html>

<style is:global>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  body {
    --color-surface: #292929;
    --color-surface-alt: #242424;
    --color-text: #f3f4f6;
    --color-text-muted: #c7c9ce;

    font-family:
      'Montserrat',
      -apple-system,
      BlinkMacSystemFont,
      'Segoe UI',
      Roboto,
      sans-serif;
    line-height: 1.6;
    color: var(--color-text);
    background-color: var(--color-surface);
    font-weight: 400;
  }

  [data-language] {
    display: none !important;
  }

  html[lang='en'] [data-language='en'],
  html[lang='fr'] [data-language='fr'] {
    display: revert !important;
  }

  body.embed-transparent {
    background: transparent;
  }

  /* Gallery row height: thumbnails.size or 160px. Smaller screens use 60% → 80% → 90% → 100% (same ratios as former 6/8/9/10 rem). */
  body {
    --row-height: calc(var(--row-height-max) * 0.6);
  }

  @media (min-width: 640px) {
    body {
      --row-height: calc(var(--row-height-max) * 0.8);
    }
  }

  @media (min-width: 768px) {
    body {
      --row-height: calc(var(--row-height-max) * 0.9);
    }
  }

  @media (min-width: 1024px) {
    body {
      --row-height: var(--row-height-max);
    }
  }

  /* Markdown content styles */
  .markdown-content p {
    margin-bottom: 1rem;
  }

  .markdown-content p:last-child {
    margin-bottom: 0;
  }

  .markdown-content strong {
    font-weight: 600;
  }

  .markdown-content em {
    font-style: italic;
  }

  .markdown-content a {
    color: #d1d5db;
    text-decoration: none;
    font-weight: 500;
    transition: color 0.2s ease;
  }

  .markdown-content a:hover {
    color: #f9fafb;
  }

  /* Light links on dark backgrounds (hero, captions) */
  .hero__description.markdown-content a,
  .image-caption.markdown-content a {
    color: #d1d5db;
  }

  .hero__description.markdown-content a:hover,
  .image-caption.markdown-content a:hover {
    color: #f3f4f6;
  }

  .markdown-content ul,
  .markdown-content ol {
    margin: 1rem 0;
    padding-left: 2rem;
  }

  .markdown-content li {
    margin-bottom: 0.5rem;
  }

  .markdown-content li:last-child {
    margin-bottom: 0;
  }

  .markdown-content blockquote {
    border-left: 3px solid currentColor;
    padding-left: 1rem;
    margin: 1rem 0;
    font-style: italic;
    opacity: 0.9;
  }

  .markdown-content code {
    background-color: rgba(255, 255, 255, 0.1);
    padding: 0.2em 0.4em;
    border-radius: 3px;
    font-family: 'Courier New', Courier, monospace;
    font-size: 0.9em;
  }

  .markdown-content pre {
    background-color: rgba(255, 255, 255, 0.06);
    padding: 1rem;
    border-radius: 5px;
    overflow-x: auto;
    margin: 1rem 0;
  }

  .markdown-content pre code {
    background-color: transparent;
    padding: 0;
  }
</style>
